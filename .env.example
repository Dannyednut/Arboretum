# ============================================================================
# ARBORETUM - multi-venue funding-carry arbitrage engine
# API key / credential template  (P5d edition)
#
#   cp .env.example .env    then fill in ONLY what your ladder step needs
#   chmod 600 .env          (secrets file; .env is gitignored, never commit)
#
# PERMISSION CONTRACT (all venues) - trade-only:
#   * enable futures/perps trading       YES
#   * enable withdrawals                 NO  <- engine must never move funds
#   * IP allowlist                       YES <- lock to the operator IP
#   * sub-account per venue where supported (blast radius = one leg)
#   The ONLY exception is the one-off BingX $100 withdrawal test, which runs
#   on a SEPARATE withdrawal-permissioned subaccount the engine never sees.
#
# CUSTODY CLASSES (Part 23 s.2):
#   [A] CEX API key      - HMAC key, trade-only + IP allowlist
#   [B] DEX scoped key   - wallet-issued delegate key (agent/sub/maker-only)
#                          NEVER paste the main wallet private key here
#   [C] raw wallet       - dedicated BURNER wallet, working capital only
#   [D] aggregator       - no direct keys (venue-native under the hood)
#
# LIVE ORDERS stay IMPOSSIBLE until every gate flips together:
#   DRY_RUN=false AND YES_REAL=true AND venue signer shipped AND ladder step
#   promoted by the operator (Part 19 s.7; Part 24 guide).  Default = off.
#
# Full per-venue instructions: download/24_p5d_integration_guide.md
# ============================================================================

# ----------------------------------------------------------------- mode ----
# EXEC_MODE: paper (default) | live (DRY_RUN shadow - paper fills stay authoritative)
# DRY_RUN:   true (default) = signed clients only log intents, place nothing
# YES_REAL:  false (default). Flip ONLY after: parity tally complete +
#            rate limiter verified + user says go. (Validator enforces this.)
EXEC_MODE=paper
DRY_RUN=true
YES_REAL=false

# ------------------------------------------------------- pilot sizing ------
# P4b starts at $50/leg; P4c scales to the $1k book (Part 19 s.7)
P4B_PILOT_USD_PER_LEG=50
MAX_NOTIONAL_USD=1000

# ===================================================================
# [A] CEX VENUES - create API key on the exchange, trade-only
# ===================================================================

# ---- binance (USDT-M fapi) ---------------------------------------- [A]
# Signer: shipped (binance-style). Ladder: $1k-capable.
# NOTE: adapter ships a token-bucket limiter + 429/-1003 backoff BEFORE the
# first signed call - sandbox IPs have been banned repeatedly.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- aster (binance-compatible V3) -------------------------------- [B]
# Separate aster account + its own key pair (same signer as binance).
# IMPORTANT (Part 23 finding): V1 API-key creation ENDED 2026-03-25 - create
# the key via the V3 flow (docs.asterdex.com); since 2026-09-01 authenticated
# V3 endpoints also require the main wallet to have completed a deposit.
ASTER_API_KEY=
ASTER_API_SECRET=

# ---- okx ------------------------------------------------------------ [A]
# 3 fields: the passphrase is generated together with the key.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ---- bingx ---------------------------------------------------------- [A]
# Trade-only key for the engine. The $100 withdrawal test uses a different
# (withdrawal-permissioned) subaccount whose keys are NOT stored here.
BINGX_API_KEY=
BINGX_API_SECRET=

# ---- bybit (v5) ----------------------------------------------------- [A]
# Signer: shipped (bybit scheme). Testnet: api-testnet.bybit.com.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ---- bitget --------------------------------------------------------- [A]
# Signer: pending (3-field HMAC) - fill keys when that cohort ships.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# ---- mexc (futures API official since 2026-03-31; KYC required) ----- [A]
# Cheapest verified schedule (maker 0.01% / taker 0.05%); re-verify at key
# time. Data (funding) currently WAF-blocked from our sandbox - Sharpe-fed.
MEXC_API_KEY=
MEXC_API_SECRET=

# ---- gate (v4 futures) ---------------------------------------------- [A]
# Native funding + books live (P5d). Testnet exists.
GATE_API_KEY=
GATE_API_SECRET=

# ---- kucoin (futures) ----------------------------------------------- [A]
# 3 fields (passphrase). Native funding + books live (P5d). Sandbox exists.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# ---- bitmex ---------------------------------------------------------- [A]
# Mid symbol-migration (XBTUSDT settled 2026-09-16) - verify listing state
# at key time. Full testnet available.
BITMEX_API_KEY=
BITMEX_API_SECRET=

# ---- deribit (majors only: BTC/ETH) --------------------------------- [A]
# Fields are the OAuth-style client id/secret from API settings.
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# ---- htx (USDT-M linear swap) ---------------------------------------- [A]
HTX_ACCESS_KEY=
HTX_SECRET_KEY=

# ---- kraken futures --------------------------------------------------- [A]
# Funding interval is regional: 8h US clients / 1h EEA+others.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---- blofin ----------------------------------------------------------- [A]
# Funding cadence is DYNAMIC since 2025-12 - engine infers from history.
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=

# ---- whitebit / toobit / weex / coinbase intl ------------------------- [A]
# Toobit/WEEX are watch-list venues (counterparty-risk checklist first,
# Part 23 s.5.2). Coinbase Intl: verify jurisdiction eligibility.
WHITEBIT_API_KEY=
WHITEBIT_API_SECRET=
TOOBIT_API_KEY=
TOOBIT_API_SECRET=
WEEX_API_KEY=
WEEX_API_SECRET=
CBINTL_API_KEY=
CBINTL_API_SECRET=

# ---- backpack --------------------------------------------------------- [A]
# DATA-ONLY by policy: 9.5/8.5 bps fee wall kills carry round trips.
BACKPACK_API_KEY=
BACKPACK_API_SECRET=

# ===================================================================
# [B] DEX SCOPED CREDENTIALS - wallet-issued delegate keys
#     RULE: the key stored here must be the SCOPED credential, never the
#     main wallet private key. Fund accounts from the main wallet; hold
#     only the delegate in .env.
# ===================================================================

# ---- hyperliquid - API wallet ("agent wallet") ------------------------ [B]
# Create: app.hyperliquid.xyz -> API -> approve agent. The agent key has NO
# withdrawal permission by design. HL_AGENT_ADDRESS = the MAIN account
# address the agent acts for. Testnet: app.hyperliquid-testnet.xyz.
HL_AGENT_ADDRESS=
HL_AGENT_PRIVATE_KEY=

# ---- paradex - SUBKEY (Starknet) -------------------------------------- [B]
# Export a subkey (NOT the account private key): subkeys cannot withdraw or
# transfer. Testnet: https://api.testnet.paradex.trade.
PARADEX_PRIVATE_KEY=

# ---- lighter - API key at an index you control ------------------------ [B]
# Create: API page -> choose unused index -> authorize. Keys can only
# secure-withdraw back to the SAME L1 address (no arbitrary transfer) -
# and maker-only key indexes additionally cannot take liquidity.
# Account/API key indexes are integers (avoid 0-3: reserved for frontends).
LIGHTER_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=

# ---- nado - account keys; use a linked signer when executing ---------- [B]
# "No API keys: the wallet key IS auth" - link a burner signer address on
# the subaccount and hold ONLY the signer key when Step 3 approaches.
NADO_API_KEY=
NADO_API_SECRET=

# ---- orderly - Orderly Key (ed25519) ---------------------------------- [B]
ORDERLY_KEY=
ORDERLY_SECRET=

# ---- extended / edgex (StarkEx family) -------------------------------- [B]
# Extended: verify API-key issuance flow at key time (Part 23 s.5.1).
# edgeX: BLOCKED on 1,000 EDGE stake for the API whitelist - priced
# decision before keys (Part 23 s.5.1).
EXTENDED_API_KEY=
EXTENDED_API_SECRET=
EDGEX_L2_PRIVATE_KEY=

# ---- apex omni ---------------------------------------------------------- [B]
APEX_API_KEY=
APEX_API_SECRET=

# ===================================================================
# [C] RAW WALLET CUSTODY - dedicated BURNER wallets only
#     Fund with working capital; never reuse across venues; never the
#     main wallet. A drained burner costs its float, nothing more.
# ===================================================================

# ---- dydx v4 - deterministic chain key --------------------------------- [C]
# The v4 client derives the dYdX-chain key from this mnemonic; treat it as
# a full-withdrawal key (it is one). Isolated mnemonic, $50/leg max.
DYDX_MNEMONIC=

# ---- drift (Solana) ------------------------------------------------------ [C]
# base58 keypair of a dedicated burner; devnet available for rehearsal.
DRIFT_KEYPAIR_B58=

# ---- vooi (aggregator) --------------------------------------------------- [D]
# No direct keys: wallet session + venue-native execution under the hood.
# Role today = free second data source; exec path = P4c decision.
